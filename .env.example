# Banco de Dados
POSTGRES_DB=mecanica
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Segurança JWT
JWT_SECRET=troque-por-uma-secret-com-pelo-menos-32-caracteres
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=http://localhost:8080

# E-mail (Ex: Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app

# Notificações
# Use "skip" no ambiente local para desabilitar o envio de e-mails.
NOTIFICACAO_EMAIL_ADMIN=skip
NOTIFICACAO_EMAIL_REMETENTE=skip

# Admin padrão local
ADMIN_EMAIL=admin@mecanica.com
ADMIN_PASSWORD=admin123
ADMIN_NOME=Administrador Padrão

# Dependency-Track local
DEPENDENCY_TRACK_VERSION=latest
DEPENDENCY_TRACK_FRONTEND_PORT=8082
DEPENDENCY_TRACK_API_PORT=8081
DEPENDENCY_TRACK_POSTGRES_DB=dependencytrack
DEPENDENCY_TRACK_POSTGRES_USER=dependencytrack
DEPENDENCY_TRACK_POSTGRES_PASSWORD=dependencytrack
