# Dependency-Track local
DEPENDENCY_TRACK_VERSION=latest
DEPENDENCY_TRACK_FRONTEND_PORT=8082
DEPENDENCY_TRACK_API_PORT=8081
DEPENDENCY_TRACK_POSTGRES_DB=dependencytrack
DEPENDENCY_TRACK_POSTGRES_USER=dependencytrack
DEPENDENCY_TRACK_POSTGRES_PASSWORD=dependencytrack

# Aplicação local (troque os valores antes de usar fora do desenvolvimento)
MECANICA_POSTGRES_DB=postgres
MECANICA_POSTGRES_USER=mecanica
MECANICA_POSTGRES_PASSWORD=mecanica
MECANICA_JWT_SECRET=0123456789abcdef0123456789abcdef
MECANICA_JWT_EXPIRATION_SECONDS=3600
MECANICA_JWT_ISSUER=http://localhost:8086
MECANICA_ADMIN_EMAIL=admin@mecanica.com
MECANICA_ADMIN_PASSWORD=admin123
MECANICA_ADMIN_NOME=Administrador Padrão

# SMTP usado pelo serviço atendimento
# Para Gmail, use uma senha de aplicativo. Para um sandbox, informe as
# credenciais SMTP fornecidas pelo serviço.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
NOTIFICACAO_EMAIL_ADMIN=${MAIL_USERNAME}
NOTIFICACAO_EMAIL_REMETENTE=${MAIL_USERNAME}
